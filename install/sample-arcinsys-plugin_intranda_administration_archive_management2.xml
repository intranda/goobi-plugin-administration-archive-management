<config_plugin>
    <export>

        <file name="*">
            <folder>/opt/digiverso/viewer/hotfolder/</folder>
        </file>

        <!--file name="2140.xml">
            <folder>/opt/digiverso/viewer/hotfolder/</folder>
        </file-->
        <!--        <file name="archive2.xml">
            <folder>/opt/digiverso/viewer01/hotfolder/</folder>
            <folder>/opt/digiverso/viewer02/hotfolder/</folder>
        </file>
        -->
    </export>
    <backup>
        <!-- backup folder -->
        <folder>/tmp/</folder>
        <!-- number of backups for each inventory -->
        <numberOfFiles>10</numberOfFiles>
        <!-- tool to create the backup files -->
        <tool>/usr/bin/mysqldump</tool>
        <!-- database password. The user name, database name, tables etc. can be recognised automatically, but the password must be entered.-->
        <!-- Leave empty if access is possible without authentication (e.g. configured in ~/.my.cnf)  -->
        <password></password>
    </backup>

    <config>
        <!-- define the name(s) of all archives for the plugin -->
        <archive>*</archive>

        <!-- default title for a new node -->
        <nodeDefaultTitle>Document</nodeDefaultTitle>

        <!-- configurations for generating process titles -->

        <!-- maximum length of the body token that will be used to generate a new process title -->
        <!-- the specifically set HEAD token and TAIL token will not be affected by this limit -->
        <!-- if the limit is positively configured, then CAMEL_CASE_LENGTH_LIMITED will be applied upon every body token, otherwise CAMEL_CASE will be applied -->
        <lengthLimit>25</lengthLimit>
        <!-- separator string that will be used to combine the tokens -->
        <separator>_</separator>

        <!-- use id from parent node instead of id from node -->
        <useIdFromParent>false</useIdFromParent>

        <!-- use shelfmark preferably instead of node id if it is available -->
        <useShelfmarkAsId>false</useShelfmarkAsId>

        <!-- configured fields are used to find identifying metadata in processes and ead nodes  -->
        <processIdentifierField>shelfmarksource</processIdentifierField>
        <nodeIdentifierField>unitid</nodeIdentifierField>

        <!-- // configurations for generating process titles // -->

        <!-- define metadata fields. All fields are displayed on the UI based on the level and the order within this file.
                - @name: contains the internal name of the field. The value can be used to translate the field in the messages files. The field must start with a letter and can not contain any white spaces.
                - @level: metadata level, allowed values are 1-7:
                    * 1: metadata for Identity Statement Area 
                    * 2: Context Area 
                    * 3: Content and Structure Area
                    * 4: Condition of Access and Use Area
                    * 5: Allied Materials Area
                    * 6: Note Area
                    * 7: Description Control Area
                - @xpath: contains a relative path to the ead value. The root of the xpath is either the <ead> element or the <c> element
                - @xpathType: type of the xpath return value, can be text, attribute, element (default)
                - @repeatable: defines if the field can exist once or multiple times, values can be true/false, default is false
                - @visible: defines if the field is displayed on the UI, values can be true/false, default is true
                - @showField: defines if the field is displayed as input field (true) or badge (false, default), affects only visible metadata
                - @fieldType: defines the type of the input field. Posible values are input (default), textarea, dropdown, multiselect, vocabulary
                - @rulesetName: internal name of the metadata in ruleset. If missing or empty, field is not imported into process metadata
                - @importMetadataInChild: defines if the field is imported or skipped in processes for child elements 
                - @inheritValueFromParent: if true and the field is empty in the current node, the value of the closest ancestor node holding a value is used when a process is created and when its metadata is updated, values can be true/false, default is false
                - @validationType: defines a validation rule, allowed values are unique, required, unique+required, regex, regex+required, regex+unique, regex+unique+required
                - @regularExpression defines a regular expression that gets used for validation type regex
                - validationError: message to display in case of validation errors
                - value: list of possible values for dropdown and multiselect lists
                - vocabulary: name of the vocabulary
                - searchParameter: distinct the vocabulary list by the given condition. Syntax is fieldname=value, field is repeatable
         -->

        <!-- internal fields, not visible on the UI -->
        <metadata
            xpath="./ead:eadheader[@countryencoding='iso3166-1'][@dateencoding='iso8601'][@langencoding='iso639-2b'][@repositoryencoding='iso15511'][@scriptencoding='iso15924']/ead:eadid/@mainagencycode"
            xpathType="attribute" name="mainagencycode" level="1" repeatable="false" visible="false" />
        <metadata xpath="./ead:eadheader/ead:profiledesc/ead:creation/ead:date/@normal" xpathType="attribute" name="normalcreationdate" level="1" repeatable="false" visible="false" />
        <metadata xpath="./ead:eadheader/ead:profiledesc/ead:creation/ead:date" xpathType="element" name="creationdate" level="1" repeatable="false" visible="false" />
        <metadata xpath="./ead:eadheader/ead:filedesc/ead:titlestmt/ead:titleproper" xpathType="element" name="titleproper" level="1" repeatable="false" visible="false" />

        <metadata xpath="./ead:control/ead:maintenancestatus/@value" xpathType="attribute" name="maintenancestatus" level="1" repeatable="false" visible="false" />

        <metadata xpath="./ead:control/ead:maintenanceagency/ead:agencyname" xpathType="element" name="agencyname" level="1" repeatable="false" visible="false" />

        <!-- repository data group -->
        <metadata xpath="./ead:archdesc/ead:did/ead:repository" group="true" name="repository" level="1" repeatable="true" visible="false" fieldType="group" rulesetName="Repository">
            <metadata xpath="@label" xpathType="attribute" name="repositoryLabel" level="1" repeatable="false" visible="true" rulesetName="RepositoryLabel" />
            <metadata xpath="ead:address/ead:addressline" xpathType="element" name="repositoryaddressline" level="1" repeatable="true" visible="true" rulesetName="RepositoryAddress" />
            <metadata xpath="ead:extref/@xlink:href" xpathType="attribute" name="extrefhref" level="1" repeatable="true" visible="true" rulesetName="RepositoryLink" />
            <metadata xpath="ead:extref/@xlink:role" xpathType="attribute" name="extrefrole" level="1" repeatable="true" visible="true" rulesetName="RepositoryLinkRole" />
            <metadata xpath="ead:extref" xpathType="element" name="extref" level="1" repeatable="true" visible="true" rulesetName="RepositoryLinkName" />

            <metadata xpath="ead:corpname" xpathType="element" name="corpname" level="1" repeatable="true" visible="true" rulesetName="RepositoryCorpName" />
            <metadata xpath="ead:corpname/@id" xpathType="attribute" name="corpnameid" level="1" repeatable="true" visible="true" rulesetName="RepositoryCorpNameId" />
            <metadata xpath="ead:corpname/@role" xpathType="attribute" name="corpnamerole" level="1" repeatable="true" visible="true" rulesetName="RepositoryCorpNameRole" />


        </metadata>

        <metadata xpath="./ead:archdesc/ead:did/ead:repository/ead:address/ead:addressline" xpathType="element" name="repositorycreatorcode" level="1" repeatable="true" visible="false" />



        <!--  Identity Statement Area -->
        <metadata xpath="./ead:control/ead:maintenanceagency/ead:agencycode" xpathType="element" name="agencycode" level="1" repeatable="false" fieldType="input" />

        <metadata xpath="./ead:eadheader/ead:eadid" xpathType="element" name="eadid" level="1" repeatable="false" showField="false" fieldType="input" rulesetName="EADID" />

        <metadata xpath="./ead:control/ead:recordid" xpathType="element" name="recordid" level="1" repeatable="false" fieldType="input" rulesetName="RecordID" />
        <metadata xpath="(./ead:archdesc/ead:did/ead:unitid[not(@type)] | ./ead:did/ead:unitid[not(@type)])[1]" xpathType="element" name="unitid" level="1" repeatable="false" showField="false"
            fieldType="input" rulesetName="UnitID" />

        <metadata xpath="./ead:did/ead:unitid[@type='Vorl. Nr.']" xpathType="element" name="Number" level="1" repeatable="true" />
        <metadata xpath="./ead:did/ead:unitid[@type='Altsignatur']" xpathType="element" name="Shelfmark" level="1" repeatable="true" rulesetName="shelfmarksource" validationType="unique">
            <validationError>The value has already been used.</validationError>
        </metadata>
        <metadata xpath="(./ead:archdesc/ead:did/ead:unitdate | ./ead:did/ead:unitdate )[1]" xpathType="element" name="unitdate" level="1" repeatable="false" rulesetName="PublicationYear"
            importMetadataInChild="false">
            <validationError>The value must be entered either as a year in the format YYYY or as a date in the format YYYY-MM-DD.</validationError>
        </metadata>
        <metadata xpath="(./ead:archdesc/ead:did/ead:unittitle | ./ead:did/ead:unittitle)[1]" xpathType="element" name="unittitle" level="1" repeatable="false" fieldType="textarea"
            rulesetName="TitleDocMain" importMetadataInChild="false" />
        <metadata xpath="(./ead:archdesc/ead:did/ead:unitdate/@normal | ./ead:did/ead:unitdate/@normal)[1]" xpathType="attribute" name="unitdatestructured" level="1" repeatable="false"
            rulesetName="DateOfOrigin" />
        <metadata xpath="./ead:archdesc/@type" xpathType="attribute" name="findingAidType" level="1" repeatable="false"
            fieldType="input" rulesetName="FindingAidType" />
        <metadata xpath="(./ead:archdesc/@level | ./@level)[1]" xpathType="attribute" name="descriptionLevel" level="1" repeatable="false" fieldType="dropdown">
            <value>collection</value>
            <value>fonds</value>
            <value>class</value>
            <value>recordgrp</value>
            <value>series</value>
            <value>subfonds</value>
            <value>subgrp</value>
            <value>subseries</value>
            <value>file</value>
            <value>item</value>
            <value>otherlevel</value>
        </metadata>


        <metadata xpath="(./ead:archdesc/ead:did/ead:physdesc/ead:dimensions | ./ead:did/ead:physdesc/ead:dimensions)[1]" xpathType="element" name="physdesc" level="1" repeatable="false"
            rulesetName="Format" />
        <metadata xpath="(./ead:archdesc/ead:did/ead:physdesc/ead:genreform | ./ead:did/ead:physdesc/ead:genreform)[1]" xpathType="element" name="genre" level="1" repeatable="false"
            rulesetName="Genre" />            

        <metadata xpath="(./ead:archdesc/ead:did/ead:physdesc/ead:extent | ./ead:did/ead:physdesc/ead:extent)[1]" xpathType="element" name="physdescstructured" level="1" repeatable="false"
            rulesetName="physicalDescriptionExtent" />

        <!-- Context Area -->
        <metadata xpath="(./ead:archdesc/ead:did/ead:origination | ./ead:did/ead:origination)" xpathType="element" name="origination"
            level="2" repeatable="true" rulesetName="Provenience" />



        <!-- Angaben zur Person: je odd/head-Bezeichner ein eigenes Feld -->
        <metadata xpath="(./ead:archdesc/ead:odd[ead:head='Angaben zur Person: Personenname']/ead:p | ./ead:odd[ead:head='Angaben zur Person: Personenname']/ead:p)"
            xpathType="element" name="personName" level="2" repeatable="false" fieldType="input" rulesetName="PersonName" />
        <metadata xpath="(./ead:archdesc/ead:odd[ead:head='Angaben zur Person: Titel / Rang']/ead:p | ./ead:odd[ead:head='Angaben zur Person: Titel / Rang']/ead:p)"
            xpathType="element" name="personTitle" level="2" repeatable="false" fieldType="input" rulesetName="PersonTitle" />
        <metadata xpath="(./ead:archdesc/ead:odd[ead:head='Angaben zur Person: Geburtsdatum']/ead:p | ./ead:odd[ead:head='Angaben zur Person: Geburtsdatum']/ead:p)"
            xpathType="element" name="personBirthDate" level="2" repeatable="false" fieldType="input" rulesetName="PersonBirthDate" />
        <metadata xpath="(./ead:archdesc/ead:odd[ead:head='Angaben zur Person: Geburtsort']/ead:p | ./ead:odd[ead:head='Angaben zur Person: Geburtsort']/ead:p)"
            xpathType="element" name="personBirthPlace" level="2" repeatable="false" fieldType="input" rulesetName="PersonBirthPlace" />
        <metadata xpath="(./ead:archdesc/ead:odd[ead:head='Angaben zur Person: Sterbedatum']/ead:p | ./ead:odd[ead:head='Angaben zur Person: Sterbedatum']/ead:p)"
            xpathType="element" name="personDeathDate" level="2" repeatable="false" fieldType="input" rulesetName="PersonDeathDate" />
        <metadata xpath="(./ead:archdesc/ead:odd[ead:head='Angaben zur Person: Religion']/ead:p | ./ead:odd[ead:head='Angaben zur Person: Religion']/ead:p)"
            xpathType="element" name="personReligion" level="2" repeatable="false" fieldType="input" rulesetName="PersonReligion" />
        <!-- mehrfach belegt: bis zu 3 Werte pro Knoten -->
        <metadata xpath="(./ead:archdesc/ead:odd[ead:head='Angaben zur Person: Beruf']/ead:p | ./ead:odd[ead:head='Angaben zur Person: Beruf']/ead:p)"
            xpathType="element" name="personProfession" level="2" repeatable="true" fieldType="input" rulesetName="PersonProfession" />
        <metadata xpath="(./ead:archdesc/ead:odd[ead:head='Angaben zur Person: Biografische Angaben']/ead:p | ./ead:odd[ead:head='Angaben zur Person: Biografische Angaben']/ead:p)"
            xpathType="element" name="personBiography" level="2" repeatable="false" fieldType="textarea" rulesetName="PersonBiographicalData" />

        <metadata xpath="(./ead:archdesc/ead:bioghist/ead:p | ./ead:bioghist/ead:p)" xpathType="element" name="bioghist" level="2" repeatable="true" fieldType="textarea"
            rulesetName="BiographicalInformation" />
        <metadata xpath="(./ead:archdesc/ead:custodhist | ./ead:custodhist)[1]" xpathType="element" name="custodhist" level="2" repeatable="false" fieldType="textarea" rulesetName="InventoryHistory" />
        <metadata xpath="(./ead:archdesc/ead:acqinfo | ./ead:acqinfo)[1]" xpathType="element" name="acqinfo" level="2" repeatable="false" fieldType="dropdown" rulesetName="AquisitionInformation">
            <value>value 1</value>
            <value>value 2</value>
            <value>...</value>
        </metadata>

        <!-- Content and Structure Area -->
        <metadata xpath="(./ead:archdesc/ead:scopecontent | ./ead:scopecontent)" group="true" name="scopecontentgroup" level="3" repeatable="true" visible="true" fieldType="group" rulesetName="ContentDescriptionGroup">
            <metadata xpath="./ead:head" xpathType="element" name="title" level="3" repeatable="false" visible="true" rulesetName="ContentDescriptionTitle" />
            <metadata xpath="./ead:p" xpathType="element" name="scopecontent" level="3" repeatable="false" visible="true" rulesetName="ContentDescription" fieldType="textarea" />
        </metadata>


        <metadata xpath="(./ead:archdesc/ead:appraisal/ead:p | ./ead:appraisal/ead:p)[1]" xpathType="element" name="appraisal" level="3" repeatable="false" fieldType="textarea"
            rulesetName="AppraisalInformation" />
        <metadata xpath="(./ead:archdesc/ead:accruals/ead:p | ./ead:accruals/ead:p)" xpathType="element" name="accruals" level="3" repeatable="true" fieldType="textarea" rulesetName="Additions" />
        <metadata xpath="(./ead:archdesc/ead:arrangement/ead:p | ./ead:arrangement/ead:p)[1]" xpathType="element" name="arrangement" level="3" repeatable="false" fieldType="textarea"
            rulesetName="Arrangement" />

        <!-- Vermerke: Deskriptoren aus odd/head; mehrfach belegt -->
        <metadata xpath="(./ead:archdesc/ead:odd[ead:head='Vermerke: Deskriptoren']/ead:p | ./ead:odd[ead:head='Vermerke: Deskriptoren']/ead:p)"
            xpathType="element" name="descriptorNote" level="3" repeatable="true" fieldType="textarea" rulesetName="DescriptorNote" />

        <metadata xpath="(./ead:archdesc/ead:controlaccess/ead:subject | ./ead:index/ead:indexentry/ead:subject)" xpathType="element" name="indexsubject" level="3" repeatable="true"
            fieldType="textarea" rulesetName="SubjectTopic" />
        <metadata xpath="(./ead:archdesc/ead:controlaccess/ead:persname | ./ead:index/ead:indexentry/ead:persname)" xpathType="element" name="indexperson" level="3" repeatable="true"
            fieldType="textarea" rulesetName="SubjectPerson" />
        <metadata xpath="(./ead:archdesc/ead:controlaccess/ead:corpname | ./ead:index/ead:indexentry/ead:corpname)" xpathType="element" name="indexcorpname" level="3" repeatable="true"
            fieldType="textarea" rulesetName="SubjectCorporate" />
        <metadata xpath="(./ead:archdesc/ead:controlaccess/ead:geogname | ./ead:index/ead:indexentry/ead:geogname)" xpathType="element" name="indexgeogname" level="3" repeatable="true"
            fieldType="textarea" rulesetName="SubjectGeographic" />


        <metadata xpath="./ead:did/ead:abstract" group="true" name="abstract" level="3" repeatable="true" visible="true" fieldType="group" rulesetName="AbstractGroup">
            <metadata xpath="@type" xpathType="attribute" name="abstractType" level="3" repeatable="false" visible="true" rulesetName="AbstractType" />
            <metadata xpath="." xpathType="element" name="abstractValue" level="3" repeatable="false" visible="true" rulesetName="AbstractValue" />
        </metadata>


        <!-- Condition of Access and Use Area -->
        <metadata xpath="(./ead:archdesc/ead:accessrestrict/ead:p  | ./ead:accessrestrict/ead:p )[1]" xpathType="element" name="accessrestrict" level="4" repeatable="false"
            rulesetName="RestrictionOnAccessLicense" importMetadataInChild="true">
            <value>open access</value>
            <value>restricted</value>
            <value>required registration</value>
        </metadata>

        <metadata xpath="(./ead:archdesc/ead:userestrict/ead:p | ./ead:userestrict/ead:p)[1]" xpathType="element" name="userestrict" level="4" repeatable="false" importMetadataInChild="true"
            rulesetName="UseRestriction">
        </metadata>

        <metadata xpath="(./ead:archdesc/ead:did/ead:langmaterial/ead:language | ./ead:did/ead:langmaterial/ead:language)" xpathType="element" name="langmaterial" level="4" repeatable="true"
            fieldType="textarea" rulesetName="DocLanguage" importMetadataInChild="false">
            <value>eng</value>
            <value>ger</value>
            <value>dut</value>
            <value>fre</value>
            <value>esp</value>
            <value>ita</value>
            <value>lat</value>
            <value>pol</value>
            <value>rus</value>
            <value>swe</value>
        </metadata>


        <metadata xpath="(./ead:archdesc/ead:dsc/ead:phystech | ./ead:dsc/ead:phystech)[1]" xpathType="element" name="phystech" level="4" repeatable="false" fieldType="textarea" rulesetName="PhysTech" />

        <metadata xpath="(./ead:archdesc/ead:otherfindaid/ead:extref | ./ead:otherfindaid/ead:extref)" group="true" name="otherfindaidgroup" level="4" repeatable="false" visible="true" fieldType="group" rulesetName="OtherFindaidGroup">
            <metadata xpath="@xlink:href" xpathType="attribute" name="uri" level="4" repeatable="false" visible="true" rulesetName="URI" />
            <metadata xpath="@xlink:role" xpathType="attribute" name="role" level="4" repeatable="false" visible="true" rulesetName="OtherFindaidRole" />
            <!-- OtherFindAid existiert im Ruleset bereits, kein eigener Typ 'otherfindaid' -->
            <metadata xpath="." xpathType="element" name="otherfindaid" level="4" repeatable="false" visible="true" rulesetName="OtherFindAid" />
        </metadata>


        <!-- Allied Materials Area -->
        <metadata xpath="(./ead:archdesc/ead:dsc/ead:originalsloc | ./ead:dsc/ead:originalsloc)[1]" xpathType="element" name="originalsloc" level="5" repeatable="false" 
            rulesetName="OriginalsLocation">

        </metadata>
        <metadata xpath="(./ead:archdesc/ead:dsc/ead:altformavail | ./ead:dsc/ead:altformavail)[1]" xpathType="element" name="altformavail" level="5" repeatable="false" 
            rulesetName="AlternativeFormAvailable">

        </metadata>
        <metadata xpath=" (./ead:archdesc/ead:relatedmaterial/ead:p | ./ead:relatedmaterial/ead:p)" xpathType="element" name="separatedmaterial"
            level="5" repeatable="false" rulesetName="SeparatedMaterial" />
        <metadata xpath="(./ead:archdesc/ead:dsc/ead:bibliography | ./ead:dsc/ead:bibliography)[1]" xpathType="element" name="bibliography" level="5" repeatable="false"
            rulesetName="BibliographicCitation" />


        <!-- Note Area -->

        <metadata xpath="(./ead:archdesc/ead:dsc/ead:odd | ./ead:dsc/ead:odd)[1]" xpathType="element" name="oddnote" level="6" repeatable="false" fieldType="textarea" rulesetName="Odd" />
        <metadata xpath="(./ead:archdesc/ead:note/ead:p | ./ead:did/ead:note/ead:p)" xpathType="element" name="didnote" level="6" repeatable="true" fieldType="textarea" rulesetName="DidNote" />

        <!-- Description Control Area -->
        <metadata xpath="./ead:control/ead:conventiondeclaration" xpathType="element" name="conventiondeclaration" level="7" repeatable="false" fieldType="multiselect"
            rulesetName="ConventionDeclaration">
            <value>val 1</value>
            <value>val 2</value>
            <value>val 3</value>
            <value>val 4</value>
        </metadata>
        <!-- root nodes -->
        <node name="archive" icon="archive" processTemplateId="456" rootNode="true" allowProcessCreation="false">
            <child>collection</child>
            <child>series</child>
            <child>folder</child>
        </node>

        <node name="collection" icon="archive" processTemplateId="456" rootNode="true" allowProcessCreation="false">
            <child>series</child>
            <child>subseries</child>
            <child>folder</child>
            <child>file</child>
            <child>item</child>
            <child>otherlevel</child>
            <child>class</child>
        </node>

        <node name="class" icon="folder-plus" processTemplateId="456" rootNode="true" allowProcessCreation="false">
            <child>class</child>
            <child>series</child>
            <child>subseries</child>
            <child>folder</child>
            <child>file</child>
            <child>item</child>
            <child>otherlevel</child>
        </node>

        <node name="series" icon="folder-open" processTemplateId="456" rootNode="false" allowProcessCreation="false">
            <child>series</child>
            <child>subseries</child>
            <child>file</child>
            <child>item</child>
            <child>otherlevel</child>
        </node>
        <node name="subseries" icon="folder-open" processTemplateId="456" rootNode="false" allowProcessCreation="false">
            <child>subseries</child>
            <child>file</child>
            <child>item</child>
            <child>otherlevel</child>
        </node>
        <node name="folder" icon="folder-open" processTemplateId="456" rootNode="false" allowProcessCreation="false">
            <child>folder</child>
            <child>file</child>
            <child>item</child>
            <child>otherlevel</child>
        </node>
        <!-- item level nodes -->
        <node name="file" ruleset="File" icon="file-text" processTemplateId="456" allowProcessCreation="true">
            <child>file</child>
        </node>    



        <node name="image" ruleset="Picture" icon="photo" processTemplateId="456" allowProcessCreation="true" />
        <node name="audio" ruleset="Audio" icon="music" processTemplateId="456" allowProcessCreation="true" />
        <node name="video" ruleset="Video" icon="video" processTemplateId="456" allowProcessCreation="true" />
        <node name="other" ruleset="Other" icon="file" processTemplateId="456" allowProcessCreation="true" />
    </config>


</config_plugin>